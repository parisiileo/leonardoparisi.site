NEXT_PUBLIC_DOMAIN="imleo.it"

# --- Contact form (Resend) ---------------------------------------------------
# Without these three the form stays usable: it falls back to opening the
# visitor's own mail client with the message prefilled.
#
# RESEND_API_KEY      resend.com → API Keys → Create (sending permission)
# CONTACT_TO_EMAIL    where enquiries land — your normal inbox
# CONTACT_FROM_EMAIL  the sender. Must be on a domain verified in Resend;
#                     a free @gmail.com address will be rejected.
RESEND_API_KEY=""
CONTACT_TO_EMAIL="parisii.leonardo@gmail.com"
CONTACT_FROM_EMAIL="hello@imleo.it"

# Any long random string, e.g. `openssl rand -base64 32`. Salts the IP hash
# used for rate limiting, so the value the server compares can never be turned
# back into an address.
CONTACT_IP_SALT=""

# Optional: Add verification codes from search consoles
# NEXT_PUBLIC_GOOGLE_VERIFICATION=
# NEXT_PUBLIC_BING_VERIFICATION=
# NEXT_PUBLIC_YANDEX_VERIFICATION=
